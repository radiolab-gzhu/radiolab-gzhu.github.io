---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>
  <div class="slider">
    {% if page.pic %}
      {% for pic in page.pic %}
        <div
          class="slide {% if forloop.first %}active{% endif %}"
          style="background-image: url('{{ pic.path }}')"
        >
          <div class="slide-title">{{ pic.title }}</div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
  <article>
    {% if site.about %}
      <div class="about-section">
        {% if site.about.title %}
          <h2 class="about-title">{{ site.about.title }}</h2>
        {% endif %}
        {% if site.about.content %}
          <div class="about-text">
            {{ site.about.content | markdownify }}
          </div>
        {% endif %}
        {% if site.about.more_info %}
          <div class="more-info">{{ site.about.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>
    <!-- member -->
    {% comment %}
      <div class="member-grid">
        <h2 class="member-title">Members</h2>
        <div class="member-grid-container">
          {% for category in site.data.members %}
            {% for person in category.group %}
              <div class="person-card">
                <div class="person-image">
                  <img src="{{ person.img }}" alt="{{ person.name }}">
                </div>
                <div class="person-name">
                  {{ person.name }}
                </div>
                {% if member.ident %}
                  <p class="ident">{{ member.ident }}</p>
                {% endif %}
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      </div>
    {% endcomment %}
    <!-- Selected papers -->
    {% comment %}
      {% if page.selected_papers %}
        <h2>
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">publications</a>
        </h2>
        {% include selected_papers.liquid %}
      {% endif %}
    {% endcomment %}
  </article>
</div>
<script>
  // 全局变量
  let currentSlide = 0;
  let slideInterval;
  const slideDuration = 5000; // 5秒切换一次

  // 获取所有幻灯片
  const slides = document.querySelectorAll('.slide');

  // 切换到指定索引的幻灯片
  function goToSlide(index) {
    // 移除所有幻灯片的激活状态
    slides.forEach((slide) => {
      slide.classList.remove('active');
    });

    // 确保索引在有效范围内
    currentSlide = (index + slides.length) % slides.length;

    // 激活当前幻灯片
    slides[currentSlide].classList.add('active');
  }

  // 切换到下一张幻灯片
  function nextSlide() {
    goToSlide(currentSlide + 1);
  }

  // 切换到上一张幻灯片
  function prevSlide() {
    goToSlide(currentSlide - 1);
  }

  // 启动轮播
  function startSlider() {
    if (slides.length > 1) {
      slideInterval = setInterval(nextSlide, slideDuration);
    }
  }

  // 停止轮播
  function stopSlider() {
    if (slideInterval) {
      clearInterval(slideInterval);
    }
  }

  // 初始化轮播
  function initSlider() {
    if (slides.length === 0) return;

    // 启动自动轮播
    startSlider();

    // 添加鼠标交互：悬停时暂停，离开时恢复
    const slider = document.querySelector('.slider');
    if (slider) {
      slider.addEventListener('mouseenter', stopSlider);
      slider.addEventListener('mouseleave', startSlider);
    }

    // 可以添加导航按钮（可选）
    addNavigationControls();
  }

  // 添加导航控件（可选功能）
  function addNavigationControls() {
    const slider = document.querySelector('.slider');

    // 创建上一张按钮
    const prevBtn = document.createElement('button');
    prevBtn.innerHTML = '&#10094;';
      prevSlide();
      startSlider(); // 点击后重置定时器
    });

    // 创建下一张按钮
    const nextBtn = document.createElement('button');
    nextBtn.innerHTML = '&#10095;';
      nextSlide();
      startSlider(); // 点击后重置定时器
    });

    slider.appendChild(prevBtn);
    slider.appendChild(nextBtn);
  }

  // 页面加载完成后初始化轮播
  document.addEventListener('DOMContentLoaded', initSlider);

  // 页面不可见时暂停轮播（优化性能）
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopSlider();
    } else {
      startSlider();
    }
  });
</script>
