---
layout: default
---
{% if page.title %}
  <div class="members-header">
    <span class="title">{{ page.title }}</span>
    <span class="description">{{ page.description }}</span>
  </div>
{% endif %}
<div class="members-list">
  {% for part in site.data.members %}
    <div class="group">
      <div class="group-header">
        <span class="group-title">{{ part.title }}</span>
        <hr class="group-hr">
      </div>
      {% comment %} ------------------old-------------------------- {% endcomment %}
        {% comment %} <div class="group-member-card-display">
          {% for member in part.group %}
            <div class="group-member-card">
              <div class="member-name-img">
                <img src="{{ member.img }}" class="member-image" alt="{{ member.name }}">
                <span class="member-name">{{ member.name }}</span>
                {% if member.ident %}
                  <p class="ident">{{ member.ident }}</p>
                {% endif %}
              </div>
              <div class="member-label">
                <ul class="member-info">
                  {% for label in member.label %}
                    <li class="member-info">
                      <span class="key">{{ label.key }}:</span>
                      {% if label.url %}
                        <a href="{{ label.url }}" class="value">{{ label.url }}</a>
                      {% endif %}
                      {% if label.value %}
                        <span class="value">{{ label.value }}</span>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endfor %}
        </div> {% endcomment %}
      {% comment %} ------------------old-------------------------- {% endcomment %}
      {% comment %} ------------------new-------------------------- {% endcomment %}
      <div class="member-grid">
        {% for member in part.group %}
          <div class="member-card">
            <div class="base-info">
              <img src="{{ member.img }}" class="img" alt="{{ member.name }}">
              <span class="name">{{ member.name }}</span>
              {% if member.ident %}
                <span class="ident">{{ member.ident }}</span>
              {% endif %}
            </div>
            <div class="more-info-contain">
              {% for label in member.label %}
                <div class="more-info">
                  <span class="key">{{ label.key }}:</span>
                  {% if label.value %}
                    <span class="value">{{ label.value }}</span>
                  {% endif %}
                  {% if label.url %}
                    <a href="{{ label.url }}" class="url">{{ label.url }}</a>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
<script>
  document.querySelectorAll('.member-card').forEach((card) => {
    let hoverTimeout;
    let isInitialized = false;

    card.addEventListener('mouseenter', () => {
      clearTimeout(hoverTimeout);
      card.classList.add('expanded');
      card.classList.add('initialized');
      isInitialized = true;
    });

    card.addEventListener('mouseleave', () => {
      if (isInitialized) {
        hoverTimeout = setTimeout(() => {
          card.classList.remove('expanded');
        }, 100);
      }
    });
  });
</script>
